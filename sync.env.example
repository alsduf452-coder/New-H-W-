# Set these in the receiving server's secret/environment settings, not in GitHub.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DB
SYNC_TOKEN=REPLACE_WITH_OUTPUT_OF_secrets.token_urlsafe_32
SYNC_SOURCE_ID=local-excel
SYNC_MAPPING_JSON={"pending_sheet":"PENDING","header_row":1,"columns":{"ID":"ID","설비":"설비","분야":"분야","상태":"상태","내용":"내용","담당자":"담당자","목표일":"목표일"}}
